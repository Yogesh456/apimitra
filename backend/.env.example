PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_connection_string

# Generate a strong one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated allowed frontend origins.
# Dev: http://localhost:5173
# Prod: https://your-frontend-domain.com,https://www.your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# FinPayUltra API key (used for services incl. OTP)
FINPAY_API_KEY=your_finpayultra_api_key

# Admin default credentials (seeded only if no admin exists; change from admin panel after login)
ADMIN_EMAIL=admin@apimitra.com
ADMIN_PASSWORD=Admin@123
